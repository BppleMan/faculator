sync-mod:
    cargo run -p faculator-x -- sync mod

watch:
    cargo run -p faculator-x -- sync mod --watch

sync-data:
    cargo run -p faculator-x -- sync data

dump:
    cargo run -p faculator-x -- dump

atlas:
    cargo run -p faculator-x -- atlas

gen-category:
    cargo run -p faculator-x -- gen category
